<?xml version="1.0" encoding="utf-8"?>
<!--
  Production: HTTPS only. The API (ApiEndpoints.baseUrl), the socket and the
  signed media URLs are all served over TLS, so plain HTTP is refused
  everywhere. Debug builds still reach the Flutter tool through the debug
  manifest; that traffic does not go through this config.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system"/>
        </trust-anchors>
    </base-config>
</network-security-config>
